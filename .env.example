# Copy to .env for local development — never commit real secrets.
CREATIVE_AGENT_ENV=dev
CREATIVE_AGENT_LOG_LEVEL=INFO
CREATIVE_AGENT_AWS_REGION=us-east-1
# Local Postgres (docker compose up -d)
CREATIVE_AGENT_DATABASE_URL=postgresql://creative_agent:creative_agent@localhost:5432/creative_agent
# SQS (from terraform output enhancement_queue_url)

CREATIVE_AGENT_ENHANCEMENT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/754639201125/creative-agent-dev-enhancement
CREATIVE_AGENT_DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:754639201125:secret:creative-agent-dev/database-GTuNOP

# Agent 1 script generation (auto | openai | template)
CREATIVE_AGENT_SCRIPT_GENERATOR=auto
# Agent 1 post-compose validation (auto | openai | rules)
# auto = OpenAI when API key is set, otherwise code rules
CREATIVE_AGENT_TRANSCRIPT_VALIDATOR=auto
# Agent 2 Script Doctor (auto | openai | deterministic) — uses guide/Agent2-guide.md
CREATIVE_AGENT_SCRIPT_DOCTOR=auto
CREATIVE_AGENT_OPENAI_API_KEY= 
CREATIVE_AGENT_OPENAI_MODEL=gpt-4o-mini
CREATIVE_AGENT_MODEL_PROVIDER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:754639201125:secret:creative-agent-dev/model-provider-NNmLvM
# Legacy/local fallback also supported: OPENAI_API_KEY=

# Intake API (optional — when unset, local dev skips API key checks)
CREATIVE_AGENT_API_KEY=

# TTS plane (Phase 3 — from terraform output tts_audio_bucket_name)
CREATIVE_AGENT_TTS_AUDIO_BUCKET=

# ElevenLabs TTS (Phase 4)
CREATIVE_AGENT_ELEVENLABS_API_KEY=
# CREATIVE_AGENT_ELEVENLABS_SECRET_ARN=
