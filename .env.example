# Copy to .env for local development — never commit real secrets.
# cp .env.example .env

# --- Core ---
CREATIVE_AGENT_ENV=dev
CREATIVE_AGENT_LOG_LEVEL=INFO
CREATIVE_AGENT_AWS_REGION=us-east-1

# --- Database ---
# Local Postgres (docker compose up -d), or Aurora URL with ?sslmode=require
CREATIVE_AGENT_DATABASE_URL=postgresql://creative_agent:creative_agent@localhost:5432/creative_agent
# On Lambda: prefer Secrets Manager instead of a URL in env
CREATIVE_AGENT_DB_SECRET_ARN=
# CREATIVE_AGENT_DB_CONNECT_TIMEOUT=8

# --- Queues (Terraform outputs) ---
CREATIVE_AGENT_ENHANCEMENT_QUEUE_URL=
CREATIVE_AGENT_TTS_QUEUE_URL=

# --- Agent 1 (composer) ---
# Script generation: auto | openai | template
CREATIVE_AGENT_SCRIPT_GENERATOR=auto
# Post-compose validation: auto | openai | rules
# auto = OpenAI when an API key is set, otherwise code rules
CREATIVE_AGENT_TRANSCRIPT_VALIDATOR=auto
# Grounded pain+pillar LLM judge (First-10 pack only; evidence quotes required)
# auto | on | off — auto = on when an OpenAI API key is set
CREATIVE_AGENT_PAIN_PILLAR_QA=auto
# End-to-end orchestrator: auto | agentic | graph
# agentic = OpenAI brain decides compose/repair/enhance/TTS; graph = deterministic LangGraph
# auto = agentic when OpenAI key is set, else graph
CREATIVE_AGENT_ORCHESTRATOR=auto

# --- Agent 2 (Script Doctor) ---
# auto | openai | deterministic — uses guide/Agent2-guide.md
CREATIVE_AGENT_SCRIPT_DOCTOR=auto

# --- OpenAI ---
CREATIVE_AGENT_OPENAI_API_KEY=
CREATIVE_AGENT_OPENAI_MODEL=gpt-4o-mini
CREATIVE_AGENT_MODEL_PROVIDER_SECRET_ARN=
# Optional model overrides (fall back to CREATIVE_AGENT_OPENAI_MODEL)
# CREATIVE_AGENT_PAUSE_PLANNER_MODEL=
# CREATIVE_AGENT_BG_SELECTOR_MODEL=
# Background bed picker from the 28-track catalog (script + wound/pillar):
# auto | openai | off — auto = OpenAI when a key is set, else calm_ambient_01
# CREATIVE_AGENT_BG_SELECTOR=auto
# Legacy/local fallback also supported:
# OPENAI_API_KEY=

# --- Intake API ---
# When unset, local dev skips API key checks
CREATIVE_AGENT_API_KEY=
# CREATIVE_AGENT_API_GATEWAY_URL=
# CREATIVE_AGENT_HEALTHCHECK_HTTP_TIMEOUT=2.5

# --- TTS plane ---
CREATIVE_AGENT_TTS_AUDIO_BUCKET=
CREATIVE_AGENT_ELEVENLABS_API_KEY=
# CREATIVE_AGENT_ELEVENLABS_SECRET_ARN=
# CREATIVE_AGENT_FFMPEG_PATH=
# CREATIVE_AGENT_FFPROBE_PATH=
